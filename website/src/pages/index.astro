---
import Base from '../layouts/Base.astro';
import DawGrid from '../components/DawGrid.astro';
import ReadsTable from '../components/ReadsTable.astro';
import { latestDownloads, storeUrl } from '../lib/release';
import { changelog } from '../lib/changelog';

const downloads = await latestDownloads();
const [latest] = changelog();
---
<Base
    page="home"
    title="DAW Project Manager — Every project, every DAW, one place"
    description="DAW Project Manager — every project, every DAW, one place. A free, open-source library for your music projects: tempo, key, plug-ins and MIDI read from the files, with phases, to-dos, work time and releases."
>
    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <div class="hero-content">
                {latest && <a href="/changelog.html" class="hero-news"><b>{latest.version}</b> What's new →</a>}
                <h1 class="hero-title">Every project, every DAW,<br>one place.</h1>
                <p class="hero-subtitle">The songs spread across your project folders, in one library: what's inside each one, where it stands, and what's left to do — from first idea to release.</p>
                <div class="hero-buttons">
                    <a href="#download" class="btn btn-primary">Download Free</a>
                    <a href="#features" class="btn btn-secondary">Explore Features</a>
                </div>
                <p class="hero-plats">macOS · Windows · Linux · Android — free &amp; open source</p>

                <div class="hero-visual">
                    <div class="app-window">
                        <img src="resources/screenshots/dashboard/dashboard-overview.png" alt="DAW Project Manager dashboard showing a table of projects across several DAWs, phases, and BPMs" class="app-screenshot">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="features">
        <div class="container">
            <div class="section-head">
                <h2 class="section-title">Project Management</h2>
                <p class="section-subtitle">Manage your DAW projects from a single application. No more folders. Never lose track of a project.</p>
            </div>

            <div class="feature-rows">

                <!-- logo collage built from existing resources/daw/logos assets — swap individual logos or add more as needed -->
                <div class="feature-row">
                    <div class="feature-visual">
                        <div class="app-window">
                            <div class="app-body placeholder-visual mock-daw-grid">
                                <img src="resources/daw/logos/ableton-live.png" alt="Ableton Live">
                                <img src="resources/daw/logos/fl-studio.png" alt="FL Studio">
                                <img src="resources/daw/logos/logic-pro.png" alt="Logic Pro">
                                <img src="resources/daw/logos/cubase.png" alt="Cubase">
                                <img src="resources/daw/logos/pro-tools.png" alt="Pro Tools">
                                <img src="resources/daw/logos/reaper.png" alt="Reaper">
                                <img src="resources/daw/logos/bitwig-studio.png" alt="Bitwig Studio">
                                <img src="resources/daw/logos/studio-one.png" alt="Studio One">
                                <img src="resources/daw/logos/ardour.png" alt="Ardour">
                                <img src="resources/daw/logos/garageband.png" alt="GarageBand">
                            </div>
                        </div>
                    </div>
                    <div class="feature-copy">
                        <div class="feature-kicker">Compatibility</div>
                        <h3>We got you covered</h3>
                        <p>Works with any publicly available DAW — <a href="#daws" class="feature-link">check the full list here</a>.</p>
                    </div>
                </div>

                <div class="feature-row reverse">
                    <div class="feature-visual">
                        <div class="app-window">
                            <img src="resources/screenshots/dashboard/dashboard-extract-metadata.png" alt="Extract Metadata option in a project's action menu" class="app-screenshot">
                        </div>
                    </div>
                    <div class="feature-copy">
                        <div class="feature-kicker">Metadata</div>
                        <h3>Advanced Metadata Extraction</h3>
                        <p>DAW version, BPM, musical key, and project notes — extracted automatically for every project, no manual tagging. For Ableton Live, Cubase, Nuendo, FL Studio and Reaper it goes further: how many tracks of each kind, which plug-ins, and every MIDI clip, ready to preview, edit and export as <code class="daw-ext">.mid</code>. <a href="#metadata-extraction" class="feature-link">See which DAWs are supported</a>; the list keeps growing.</p>
                    </div>
                </div>

                <div class="feature-row">
                    <div class="feature-visual">
                        <div class="app-window">
                            <img src="resources/screenshots/project-detail/preview-player-playback.gif" alt="Playing a found preview song in the app" class="app-screenshot">
                        </div>
                    </div>
                    <div class="feature-copy">
                        <div class="feature-kicker">Preview</div>
                        <h3>Finds Your Mixdowns Automatically</h3>
                        <p>Export a mix from your DAW and DAW Project Manager finds the file on its own, making it playable for preview right inside the app.</p>
                    </div>
                </div>

                <div class="feature-row reverse">
                    <div class="feature-visual">
                        <div class="app-window">
                            <img src="resources/screenshots/google-drive-sync/drive-setup-signin.png" alt="Settings — Google Drive Sync, with sign-in and auto-backup controls" class="app-screenshot">
                        </div>
                    </div>
                    <div class="feature-copy">
                        <div class="feature-kicker">Privacy</div>
                        <h3>Offline First</h3>
                        <p>Everything lives on your machine. You can optionally sync your project metadata to your own Google Drive — your project files are never sent to the cloud.</p>
                    </div>
                </div>

                <div class="feature-row">
                    <div class="feature-visual visual-duo">
                        <div class="app-window">
                            <img src="resources/screenshots/task-queue/task-queue-overview.png" alt="Task Queue tab showing pending todos grouped by project" class="app-screenshot">
                        </div>
                        <div class="app-window app-window-inset">
                            <img src="resources/screenshots/project-detail/project-detail-todos.png" alt="Per-project TODO list on a project's detail page" class="app-screenshot">
                        </div>
                    </div>
                    <div class="feature-copy">
                        <div class="feature-kicker">Tasks</div>
                        <h3>TODO Lists</h3>
                        <p>Keep a checklist per project, then see every unfinished task across your whole library in one unified queue — check things off without ever leaving it.</p>
                    </div>
                </div>

                <div class="feature-row reverse">
                    <div class="feature-visual visual-duo">
                        <div class="app-window">
                            <img src="resources/screenshots/settings/settings-phases-customize.png" alt="Phases settings — reorder, recolor, and rename production phases" class="app-screenshot">
                        </div>
                        <div class="app-window app-window-inset">
                            <img src="resources/screenshots/dashboard/dashboard-phase-change.png" alt="Changing a project's phase directly from the dashboard table" class="app-screenshot">
                        </div>
                    </div>
                    <div class="feature-copy">
                        <div class="feature-kicker">Workflow</div>
                        <h3>Phases</h3>
                        <p>Rename, reorder, and color your own production phases instead of a fixed pipeline. Mark one as "finished," and every change is logged to the project timeline.</p>
                    </div>
                </div>

                <div class="feature-row">
                    <div class="feature-visual">
                        <div class="app-window">
                            <img src="resources/screenshots/templates/project-template-create-from.png" alt="Create dialog for a new project, with a naming scheme selected" class="app-screenshot">
                        </div>
                    </div>
                    <div class="feature-copy">
                        <div class="feature-kicker">Project Creation</div>
                        <h3>Create New Projects, Right From the App</h3>
                        <p>Skip the folder shuffle — create a new project directly from DAW Project Manager, with a naming scheme, artist, and track name set up in seconds.</p>
                    </div>
                </div>

                <div class="feature-row reverse">
                    <div class="feature-visual">
                        <div class="app-window">
                            <img src="resources/screenshots/templates/project-templates-list.png" alt="Project Templates page listing saved templates" class="app-screenshot">
                        </div>
                    </div>
                    <div class="feature-copy">
                        <div class="feature-kicker">Templates</div>
                        <h3>Save It Once, Reuse It Forever</h3>
                        <p>Turn any project into a reusable template — BPM, key, DAW, and starter files included — then spin up new projects pre-filled from it.</p>
                    </div>
                </div>

            </div>

            <p class="section-more">And much more — see the full walkthrough in the <a href="/docs.html">documentation</a>.</p>
        </div>
    </section>

    <!-- Supported DAWs Section -->
    <section id="daws" class="daws">
        <div class="container">
            <h2 class="section-title">Supported DAWs</h2>
            <p class="section-subtitle">Automatically detects projects from all major Digital Audio Workstations</p>

            <div class="daws-search">
                <input type="text" id="daw-search-input" class="daw-search-input" placeholder="Find your DAW…" autocomplete="off">
                <p class="daws-search-empty" id="daw-search-empty" style="display: none;">No DAW matches your search.</p>
            </div>

            <DawGrid variant="home" />

            <div id="metadata-extraction" class="metadata-extraction">
                <h3 class="metadata-extraction-title">Metadata Extraction Support</h3>
                <p class="metadata-extraction-subtitle">These DAWs get BPM, key and version read straight from the project file — and, where supported, project notes, the tracks and plug-ins the project uses, and its MIDI clips. The list keeps growing.</p>

                <label class="metadata-filter">
                    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                    <input type="search" id="metadata-filter" placeholder="Find your DAW…" aria-label="Find your DAW in the table" autocomplete="off">
                </label>

                <ReadsTable variant="home" />
            </div>
        </div>
    </section>

    <!-- Download Section -->
    <section id="download" class="download">
        <div class="container">
            <h2 class="section-title">Download</h2>
            <p class="section-subtitle">Free and open source — always</p>

            <div class="download-cards">
                <div class="download-card" id="windows-download" style="display: none;">
                    <div class="download-icon">
                        <img src="resources/os/Windows_logo_-_2012.svg" alt="Windows" class="os-logo">
                    </div>
                    <h3>Windows</h3>
                    <p>Windows 10 or later (64-bit)</p>
                    <a href={storeUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
                        Download for Windows
                    </a>
                    <p class="download-note">Prefer not to use the Microsoft Store? <a href={downloads.windowsInstaller} class="download-note-link">Download the installer (.exe)</a> instead. It isn't code-signed yet, so Windows may show <strong>Windows protected your PC</strong> — click <strong>More info → Run anyway</strong>.</p>
                    <div class="other-platform-link" id="windows-other-platform" style="display: none;">
                        <a href={downloads.macos} class="btn-link" target="_blank" rel="noopener noreferrer">
                            Download for macOS instead
                        </a>
                        <a href={downloads.linuxAppImage} class="btn-link" target="_blank" rel="noopener noreferrer">
                            Download for Linux instead
                        </a>
                    </div>
                </div>

                <div class="download-card" id="macos-download" style="display: none;">
                    <div class="download-icon">
                        <img src="resources/os/MacOS_logo_(2017).svg" alt="macOS" class="os-logo">
                    </div>
                    <h3>macOS</h3>
                    <p>macOS 10.14 or later</p>
                    <a href={downloads.macos} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
                        Download for macOS
                    </a>
                    <p class="download-note">Not notarized by Apple yet — after opening the app, go to <strong>System Settings → Privacy &amp; Security</strong> and click <strong>Open Anyway</strong> to run it.</p>
                    <div class="other-platform-link" id="macos-other-platform" style="display: none;">
                        <a href={storeUrl} class="btn-link" target="_blank" rel="noopener noreferrer">
                            Download for Windows instead
                        </a>
                        <a href={downloads.linuxAppImage} class="btn-link" target="_blank" rel="noopener noreferrer">
                            Download for Linux instead
                        </a>
                    </div>
                </div>

                <div class="download-card" id="linux-download" style="display: none;">
                    <div class="download-icon">
                        <img src="resources/os/Linux_logo.svg" alt="Linux" class="os-logo">
                    </div>
                    <h3>Linux</h3>
                    <p>AppImage &mdash; no install, no sandbox, works on most distros</p>
                    <a href={downloads.linuxAppImage} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
                        Download for Linux
                    </a>
                    <div class="other-platform-link" id="linux-other-platform" style="display: none;">
                        <a href={storeUrl} class="btn-link" target="_blank" rel="noopener noreferrer">
                            Download for Windows instead
                        </a>
                        <a href={downloads.macos} class="btn-link" target="_blank" rel="noopener noreferrer">
                            Download for macOS instead
                        </a>
                    </div>
                </div>
            </div>

            <div class="download-info">
                <p>On Linux, also on <a href="https://flathub.org/en/apps/com.bandpassrecords.dpm" target="_blank" rel="noopener noreferrer">Flathub</a>. Source code and all releases on <a href="https://github.com/bandpassrecords/daw-project-manager" target="_blank" rel="noopener noreferrer">GitHub</a></p>
            </div>
        </div>
    </section>

    <!-- Android Testing Section -->
    <section id="android-testing" class="android-testing">
        <div class="container">
            <div class="android-testing-card">
                <img src="resources/os/android-head.png" alt="Android" class="android-testing-icon">
                <h2>Android — Join the Test</h2>
                <p>DAW Project Manager for Android is currently in testing. Join the Google Group to get access and find instructions for downloading the testing app.</p>
                <a href="https://groups.google.com/g/daw-project-manager-android-testers" class="btn btn-primary" target="_blank" rel="noopener noreferrer">
                    Join Now
                </a>
            </div>
        </div>
    </section>

    <!-- Screenshot Lightbox -->
    <div class="lightbox" id="lightbox">
        <button class="lightbox-close" id="lightbox-close" aria-label="Close">&times;</button>
        <img src="" alt="" class="lightbox-img" id="lightbox-img">
    </div>

    <style>
        /* The newest release, from the app's changelog. */
        .hero-news {
            display: inline-flex;
            align-items: center;
            gap: .6rem;
            margin-bottom: 1.6rem;
            padding: .35rem .9rem .35rem .4rem;
            border: 1px solid var(--border-color);
            border-radius: 999px;
            background: var(--bg-card);
            color: var(--text-secondary);
            font-size: .88rem;
            text-decoration: none;
            transition: border-color .2s, color .2s;
        }
        .hero-news:hover { border-color: var(--accent); color: var(--text-primary); }
        .hero-news b {
            padding: .1rem .55rem;
            border-radius: 999px;
            background: rgba(74, 158, 255, .14);
            color: var(--accent);
            font-weight: 600;
        }
    </style>

    <script>
        import '../scripts/home.js';
    </script>
</Base>
